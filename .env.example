# Supabase — required for database access
# Get these from: Supabase Dashboard → Project Settings → API

# Public (safe for browser reference only — never use for data queries)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Server-only (NEVER expose to client — used by service layer)
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Vapi — required for outbound calling
VAPI_API_KEY=
VAPI_ASSISTANT_ID=
VAPI_PHONE_NUMBER_ID=
VAPI_WEBHOOK_SECRET=
# Optional override (default: https://api.vapi.ai)
# VAPI_BASE_URL=https://api.vapi.ai
